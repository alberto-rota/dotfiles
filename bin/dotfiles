#!/usr/bin/env bash
# The dotfiles CLI -- one command on PATH for everything you would otherwise
# have to cd into the checkout to do.
#
#     dotfiles reconfigure     # change colours / machine name / tool selection
#     dotfiles update          # pull, then re-render and re-link
#     dotfiles backups         # what install.sh saved before taking a path over
#     dotfiles uninstall       # reset.sh: undo the install, restore the backups
#     dotfiles purge           # ...and then delete the checkout itself
#
# This is NOT a second implementation of any of that: every subcommand shells
# out to install.sh, reset.sh or lib/tools.sh in the checkout, so there is still
# exactly one installer and one uninstaller. What lives here is only the part
# that cannot: finding the checkout from outside it, and the ordering and the
# guards that make `purge` safe (backups restored BEFORE the directory holding
# reset.sh goes away, and a refusal when the repo has work in it that exists
# nowhere else).
#
# bin/ is plain-copied to ~/.local/bin by install.sh -- not symlinked, not
# rendered -- which is exactly what this file needs: a copy keeps working when
# the checkout moves, and `purge` must survive the checkout being deleted from
# under it. It also means there is no @PLACEHOLDER@ to point at the checkout
# with, hence the pointer file that install.sh writes and find_checkout() reads.
#
# bash 3.2 (macOS) throughout: no associative arrays, no ${var,,}, no mapfile.
set -eu

XDG_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$XDG_CONFIG/dotfiles"
# Written by install.sh alongside this very copy of the CLI, so a `dotfiles` on
# PATH always has a pointer beside it saying which checkout put it there.
POINTER="$STATE_DIR/checkout"
MANIFEST="$STATE_DIR/manifest.txt"

SELF="$(basename "$0")"

die() { echo "$SELF: $*" >&2; exit 1; }

# Same two-file test install.sh's own bootstrap uses, for the same reason: it
# tells a checkout of this repo from any other directory that happens to exist.
is_checkout() { [ -r "$1/install.sh" ] && [ -r "$1/lib/derive.sh" ]; }

# Where the checkout is. $DOTFILES_DIR wins (it is the same override install.sh
# takes, so a machine with the repo somewhere unusual needs no second setting),
# then the pointer install.sh wrote, then the default location -- which covers a
# checkout that was cloned by hand and never installed from.
find_checkout() {
  local d=""
  if [ -n "${DOTFILES_DIR:-}" ] && is_checkout "$DOTFILES_DIR"; then
    printf '%s' "$DOTFILES_DIR"; return 0
  fi
  if [ -r "$POINTER" ]; then
    # `|| true` because read returns non-zero on a final line with no newline,
    # and this script runs under set -e.
    IFS= read -r d < "$POINTER" || true
    if [ -n "$d" ] && is_checkout "$d"; then printf '%s' "$d"; return 0; fi
  fi
  if is_checkout "$HOME/dotfiles"; then printf '%s' "$HOME/dotfiles"; return 0; fi
  return 1
}

need_checkout() {
  DOTFILES="$(find_checkout || true)"
  [ -n "$DOTFILES" ] || die "no dotfiles checkout found.
  Looked at: \$DOTFILES_DIR, $POINTER, $HOME/dotfiles
  Get one back with:
    curl -fsSL albertorota.dev/setmeup.sh | bash
  or point this at an existing one:
    DOTFILES_DIR=/path/to/dotfiles $SELF <command>"
}

usage() {
  cat <<EOF
Usage: $SELF <command> [options]

  install [opts]      Re-run install.sh: re-render every template and re-link.
                      Reuses the saved answers, so it does not prompt.
  reconfigure [opts]  install.sh --reconfigure: change the colours, machine name,
                      status-line components and tool selection.
  update [opts]       Fast-forward the checkout, then install (no prompting).
                      Stops with the reason if the checkout cannot be refreshed,
                      rather than quietly re-rendering the old code;
                      --keep-going installs from it as it stands anyway.
  tools [opts]        install.sh --tools-only: install the software, touch no config.
  plan                What a tools run would do on this machine, without doing it.

  backups             List the .bak files install.sh saved when it took a path over.
  uninstall [-y]      reset.sh: remove every path install.sh created and restore
                      each backup. Leaves the checkout, and the software, in place.
  purge [-y] [--force]
                      uninstall, and THEN delete the checkout and the saved answers.
                      Backups are restored first, before the directory goes away.
                      Refuses if the repo has uncommitted or unpushed work
                      (--force overrides); -y skips the typed confirmation.

  path                Print the checkout directory ('cd "\$($SELF path)"').
  help                Show this message.

Any options after the command are passed through, so '$SELF install --no-tools'
and '$SELF reconfigure --no-tui' work the way they do on install.sh itself.

The checkout is found from \$DOTFILES_DIR, then $POINTER
(written by install.sh), then $HOME/dotfiles.
EOF
}

# --- commands -----------------------------------------------------------------

cmd_install()     { need_checkout; exec bash "$DOTFILES/install.sh" "$@"; }
cmd_reconfigure() { need_checkout; exec bash "$DOTFILES/install.sh" --reconfigure "$@"; }
cmd_tools()       { need_checkout; exec bash "$DOTFILES/install.sh" --tools-only "$@"; }
cmd_plan()        { need_checkout; exec bash "$DOTFILES/lib/tools.sh" --plan; }
cmd_path()        { need_checkout; printf '%s\n' "$DOTFILES"; }

# Why did the fast-forward refuse? git's own message is accurate and generic,
# and the case that actually happens here -- a tracked file edited on this
# machine that the incoming commits also touch -- is the one it describes least
# usefully, because the remedy is "these specific files" and git names them in a
# wall of text that has already scrolled past by the time install.sh finishes.
# So work it out and say it in two lines. Every branch ends in a command to run.
update_diagnose() {
  local branch up blocking colliding behind ahead

  branch="$(git -C "$DOTFILES" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  if [ "$branch" = HEAD ]; then
    echo "  Cause: the checkout is on a detached HEAD, so there is no branch to"
    echo "         fast-forward. To get back on the branch:"
    echo "           git -C $DOTFILES checkout main"
    return 0
  fi

  # `|| true` on both: no upstream is a normal state, not an error, and this
  # script runs under set -e.
  up="$(git -C "$DOTFILES" rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)"
  if [ -z "$up" ]; then
    echo "  Cause: branch '$branch' has no upstream, so there is nothing to pull."
    echo "         To point it at the remote branch of the same name:"
    echo "           git -C $DOTFILES branch --set-upstream-to=origin/$branch"
    return 0
  fi

  # Can we see the remote at all? Checked before anything about the working
  # tree, because no network and no credentials both present as a failed pull on
  # a checkout that is otherwise in perfect shape -- and the answer there is
  # "try later", not "go and edit your files".
  if ! git -C "$DOTFILES" ls-remote --exit-code origin >/dev/null 2>&1; then
    echo "  Cause: could not reach the remote -- no network, or no credentials"
    echo "         for it on this machine. The checkout itself is fine; nothing"
    echo "         here needs fixing, so try again when the remote is reachable."
    return 0
  fi

  # Tracked files this machine has changed (staged or not -- hence `diff HEAD`
  # rather than a bare `diff`) that the incoming commits ALSO change. That
  # intersection is precisely what git refuses to overwrite: a local edit to a
  # file the range does not touch does not block a fast-forward at all, so
  # listing every modified file would send you after the wrong ones.
  blocking="$(comm -12 \
    <(git -C "$DOTFILES" diff --name-only HEAD 2>/dev/null | sort) \
    <(git -C "$DOTFILES" diff --name-only "HEAD..$up" 2>/dev/null | sort) || true)"
  if [ -n "$blocking" ]; then
    echo "  Cause: these files are edited here AND changed by the incoming commits,"
    echo "         so git will not overwrite them:"
    printf '           %s\n' $blocking
    echo ""
    echo "         If the edits matter, keep them:"
    echo "           git -C $DOTFILES stash push -m pre-update $blocking"
    echo "         If they do not, throw them away:"
    echo "           git -C $DOTFILES checkout -- $blocking"
    echo "         Then re-run '$SELF update'. Worth a look at the diff first:"
    echo "           git -C $DOTFILES diff -- $blocking"
    return 0
  fi

  # Untracked files sitting where the incoming commits want to create one. This
  # is the renamed-file case: a template that moved between directories arrives
  # as a create, and a leftover copy at the destination stops the whole pull.
  colliding="$(comm -12 \
    <(git -C "$DOTFILES" ls-files --others --exclude-standard 2>/dev/null | sort) \
    <(git -C "$DOTFILES" diff --name-only "HEAD..$up" 2>/dev/null | sort) || true)"
  if [ -n "$colliding" ]; then
    echo "  Cause: these untracked files are in the way of files the incoming"
    echo "         commits create:"
    printf '           %s\n' $colliding
    echo ""
    echo "         Move them aside (or delete them) and re-run '$SELF update':"
    echo "           git -C $DOTFILES stash push -u -m pre-update $colliding"
    return 0
  fi

  # Local commits: a fast-forward is impossible by definition, and this is the
  # one cause whose remedy is a judgement call rather than a command, since
  # those commits may be work that exists nowhere else.
  ahead="$(git -C "$DOTFILES" rev-list --count "$up..$branch" 2>/dev/null || echo 0)"
  behind="$(git -C "$DOTFILES" rev-list --count "$branch..$up" 2>/dev/null || echo 0)"
  if [ "$ahead" -gt 0 ]; then
    echo "  Cause: '$branch' has $ahead commit(s) that '$up' does not, so it cannot"
    echo "         fast-forward ($behind commit(s) waiting on the other side)."
    echo "         What those local commits are:"
    echo "           git -C $DOTFILES log --oneline $up..$branch"
    echo "         Then either replay them on top:"
    echo "           git -C $DOTFILES pull --rebase"
    echo "         or, if they are not worth keeping, discard them:"
    echo "           git -C $DOTFILES reset --hard $up"
    return 0
  fi

  # Nothing above matched, so git refused for a reason this function has never
  # seen. Say that plainly instead of guessing, and hand over the two commands
  # that will show it.
  echo "  Cause: not one this CLI recognises -- the checkout looks clean and"
  echo "         '$branch' is not ahead of '$up'. The full picture:"
  echo "           git -C $DOTFILES status"
  echo "           git -C $DOTFILES pull --ff-only"
}

# Refresh the checkout, then install from it with no prompting -- the two halves
# of "get this machine onto the current dotfiles".
#
# A REFUSED REFRESH IS FATAL HERE, and that is the whole point of the shape
# below. This used to print a NOTE and install anyway, which made the one
# command whose entire job is "get the new code" report success while rendering
# the OLD code. On a machine whose tracked claude/settings.json carried a
# one-line local edit, `git pull --ff-only` aborted, the NOTE scrolled past in a
# screenful of install output, and the prompt, both status bars and even the
# setup UI's live preview all stayed quietly on the previous commit -- through
# repeated updates, because every one of them failed in exactly the same
# invisible way. The plan-vs-run split lib/tools.sh goes to such lengths to
# avoid has an update-vs-updated twin, and this was it. So: update either
# updates or says it did not, out loud, with the reason and the remedy.
#
# install.sh's own bootstrap deliberately does the opposite -- every failed
# refresh there falls through to installing what is on disk -- and the two are
# not in conflict. Its job is to get a machine set up AT ALL, where local edits
# or no network are reasons to use what you have rather than to leave somebody
# with nothing. Here there is already a working install to keep, so stopping
# costs nothing and carrying on costs you the truth.
#
# --keep-going restores the old behaviour for the one case that wants it: an
# offline machine where you are re-rendering after editing a template and know
# perfectly well the checkout is stale.
#
# Only the git case is handled here on purpose. A checkout that came from the
# tarball route (a machine with no git) is refreshed by install.sh's own
# bootstrap, which owns fetch_tarball() and the stamp that says re-extracting is
# safe; reimplementing that here is exactly the kind of second copy this file
# exists to avoid. So say which one line to run and carry on installing from
# what is already there.
cmd_update() {
  need_checkout
  local keep=0 a
  # bash 3.2: build the pass-through list in an array rather than reassigning $@
  # with a shift dance, and expand it below in the ${a[@]+...} form that survives
  # set -u when it is empty.
  local args=()
  for a in "$@"; do
    case "$a" in
      --keep-going) keep=1 ;;
      *) args+=("$a") ;;
    esac
  done

  if [ -d "$DOTFILES/.git" ] && command -v git >/dev/null 2>&1; then
    echo "Fast-forwarding $DOTFILES ..."
    if ! git -C "$DOTFILES" pull --ff-only; then
      echo ""
      echo "Could not fast-forward $DOTFILES."
      update_diagnose
      if [ "$keep" -eq 0 ]; then
        echo ""
        echo "  NOTHING WAS INSTALLED. The checkout is still on"
        echo "  $(git -C "$DOTFILES" log --oneline -1 2>/dev/null || echo '?')"
        echo "  and installing from it would have looked like an update without"
        echo "  being one. Fix the above and re-run, or if that is what you want:"
        echo "    $SELF update --keep-going   # re-render from the checkout as it is"
        echo "    $SELF install               # the same, without trying to refresh"
        exit 1
      fi
      echo ""
      echo "Continuing anyway (--keep-going): installing from the checkout as it stands."
    fi
  else
    echo "NOTE: $DOTFILES is not a git checkout, so there is nothing to pull."
    echo "      To refresh a tarball checkout in place:"
    echo "        curl -fsSL albertorota.dev/setmeup.sh | bash"
    echo "      Installing from the checkout as it stands."
  fi
  echo ""
  exec bash "$DOTFILES/install.sh" -y ${args[@]+"${args[@]}"}
}

# Every backup still on disk, read off the manifest -- the same file reset.sh
# works from, so this shows precisely what an uninstall would put back and what
# it would leave for you to sort out.
cmd_backups() {
  [ -r "$MANIFEST" ] || die "no manifest at $MANIFEST -- install.sh has not run on this machine."
  local dst found=0 extra=0 n
  while IFS= read -r dst || [ -n "$dst" ]; do
    [ -n "$dst" ] || continue
    if [ -e "$dst.bak" ] || [ -L "$dst.bak" ]; then
      printf '  %s.bak\n      -> restored to %s by "%s uninstall"\n' "$dst" "$dst" "$SELF"
      found=$((found + 1))
    fi
    # .bak.2 and up: a real file turned up at a path install.sh had already taken
    # over, so it was saved without displacing this machine's original .bak.
    # reset.sh deliberately does not choose between them.
    n=2
    while [ -e "$dst.bak.$n" ] || [ -L "$dst.bak.$n" ]; do
      printf '  %s.bak.%s\n      -> left alone (a later file at an already-managed path)\n' "$dst" "$n"
      extra=$((extra + 1))
      n=$((n + 1))
    done
  done < "$MANIFEST"
  echo ""
  if [ "$found" -eq 0 ] && [ "$extra" -eq 0 ]; then
    echo "No backups: nothing was already at any of the paths install.sh took over."
  else
    echo "$found original backup(s) to restore, $extra numbered backup(s) left alone."
  fi
}

# reset.sh does the work; what is added here is telling you, before it runs,
# that this command deletes itself.
cmd_uninstall() {
  need_checkout
  echo "Undoing the install from $DOTFILES:"
  echo "  reset.sh removes every path install.sh created and restores each .bak."
  echo "  This CLI is one of those paths ($HOME/.local/bin/$SELF), so it goes too."
  echo "  The checkout stays -- 'bash $DOTFILES/install.sh' brings it all back,"
  echo "  and '$SELF purge' is what also deletes the checkout."
  echo ""
  exec bash "$DOTFILES/reset.sh" "$@"
}

# Does the repo hold anything that exists nowhere but this machine? Committing
# is the whole point of this checkout, so deleting one with unpushed work in it
# is the one genuinely unrecoverable thing this CLI can do.
#
# Answers "yes" for a branch with no upstream: its commits have no other home by
# definition. Answers "no" for a checkout with no .git at all -- the tarball
# route -- which is honest rather than reassuring: there is no way to tell an
# edited file there from a pristine one, and purge says so.
repo_has_unsaved_work() {
  [ -d "$DOTFILES/.git" ] || return 1
  command -v git >/dev/null 2>&1 || return 1
  [ -n "$(git -C "$DOTFILES" status --porcelain 2>/dev/null || true)" ] && return 0
  local upstream
  upstream="$(git -C "$DOTFILES" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  [ -n "$upstream" ] || return 0
  [ -n "$(git -C "$DOTFILES" log --oneline "$upstream..HEAD" 2>/dev/null || true)" ] && return 0
  return 1
}

# The destructive one. Order matters more than anything else here: reset.sh
# lives IN the checkout and is what restores this machine's original files, so
# it has to run and finish while the directory is still there.
cmd_purge() {
  local assume_yes=0 force=0 reply
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) assume_yes=1 ;;
      -f|--force) force=1 ;;
      -h|--help) usage; exit 0 ;;
      *) die "purge: unknown option: $1" ;;
    esac
    shift
  done

  need_checkout
  # Nothing about find_checkout() can return either of these, but this is the
  # one command where a wrong answer is an `rm -rf` of it.
  case "$DOTFILES" in
    /|"$HOME") die "refusing to delete $DOTFILES" ;;
  esac

  if repo_has_unsaved_work; then
    echo "$DOTFILES has uncommitted or unpushed work:"
    echo ""
    git -C "$DOTFILES" status --short --branch 2>/dev/null || true
    echo ""
    if [ "$force" -eq 0 ]; then
      die "purge: refusing to delete it. Push or stash it first, or re-run with --force."
    fi
    echo "--force given; deleting it anyway."
    echo ""
  fi

  echo "This will, in this order:"
  echo "  1. run reset.sh -y: remove every path install.sh created in \$HOME and"
  echo "     restore each original file from the .bak beside it"
  echo "  2. delete the checkout            $DOTFILES"
  echo "  3. delete the dotfiles state dir  $STATE_DIR"
  echo "     (the saved colour/machine/tool answers, and the now-inert uv and"
  echo "      tools PATH fragments)"
  echo ""
  echo "It does NOT uninstall the software the tools phase put on this machine"
  echo "(oh-my-posh, herdr, tmux, cargo, Neovim, ...). Numbered backups"
  echo "(.bak.2 and up) are left where they are; '$SELF backups' lists them."
  [ -d "$DOTFILES/.git" ] || echo "Note: no .git here, so local edits could not be checked for."
  echo ""

  if [ "$assume_yes" -eq 0 ]; then
    if [ ! -t 0 ]; then
      die "purge: no terminal to confirm on; pass -y if you really mean it."
    fi
    printf 'Type "purge" to go ahead: '
    read -r reply || reply=""
    [ "$reply" = purge ] || { echo "Aborted; nothing was changed."; exit 1; }
    echo ""
  fi

  # Out of the checkout before anything deletes it: if this was launched from
  # inside it, rm would be pulling the rug out from under our own cwd.
  cd "$HOME"

  echo "--- restoring backups (reset.sh) ---"
  # Not fatal on its own: a half-completed reset still leaves less behind than
  # stopping here would, and the paths it did not manage to remove are named in
  # its own output. But do not go on to delete the checkout, because reset.sh is
  # in it and re-running it is then impossible.
  # DOTFILES_PURGING silences reset.sh's closing "re-run install.sh from the
  # checkout" note -- true when reset.sh is run on its own, a lie two lines
  # before that checkout is deleted.
  DOTFILES_PURGING=1 bash "$DOTFILES/reset.sh" -y || die "purge: reset.sh failed; the checkout was NOT deleted.
  Look at what it printed, fix it, then re-run '$SELF purge'."

  echo ""
  echo "--- deleting the checkout ---"
  rm -rf "$DOTFILES"
  echo "Removed $DOTFILES"
  rm -rf "$STATE_DIR"
  echo "Removed $STATE_DIR"

  echo ""
  echo "Done. This shell still has the old aliases, PATH and prompt loaded --"
  echo "they go with the next new shell (or 'exec \$SHELL -l' now)."
  echo "To set all of this up again:"
  echo "    curl -fsSL albertorota.dev/setmeup.sh | bash"
}

# --- dispatch -----------------------------------------------------------------

[ $# -gt 0 ] || { usage; exit 0; }
cmd="$1"; shift
case "$cmd" in
  install)             cmd_install "$@" ;;
  reconfigure|config)  cmd_reconfigure "$@" ;;
  update)              cmd_update "$@" ;;
  tools)               cmd_tools "$@" ;;
  plan)                cmd_plan "$@" ;;
  backups)             cmd_backups "$@" ;;
  uninstall|reset)     cmd_uninstall "$@" ;;
  purge)               cmd_purge "$@" ;;
  path|where)          cmd_path "$@" ;;
  help|-h|--help)      usage ;;
  *) echo "$SELF: unknown command: $cmd" >&2; echo "" >&2; usage >&2; exit 2 ;;
esac
