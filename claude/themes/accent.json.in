{
#>> Claude Code's own UI, in this machine's two accents. Replaces the old
#>> yellow-border.json (which set only promptBorder + clawd_body) and
#>> monokai.json, every key of which was fiction -- see below.
#>>
#>> THE KEY NAMES HERE ARE NOT NEGOTIABLE AND NOT GUESSABLE. Claude Code merges a
#>> custom theme with `if (Object.hasOwn(base, key) && validColour(value))`, so a
#>> key it does not already have is dropped **silently** -- no error, no warning,
#>> no hint that the file did nothing. That is how monokai.json.in came to carry
#>> 50 VS Code-flavoured names (ui.border, terminal.brightBlue, button.hover,
#>> lineNumberActive) that never existed and never applied. If a key stops working
#>> after a Claude Code update, it was renamed upstream and the failure will look
#>> exactly like this file being ignored. The list can be recovered from the
#>> binary:  strings ~/.local/share/claude/versions/<v> | grep -A40 autoAccept
#>>
#>> Accepted value forms are rgb(r,g,b), #rrggbb, #rgb, ansi256(n) and
#>> ansi:<name>. Plain hex is what the accents already are, so they substitute
#>> straight in with no conversion.
  "name": "@MACHINE_LOWER@ accents",
  "base": "dark",
  "overrides": {
#>> PRIMARY -- everything that is Claude addressing you. These four keys are the
#>> light blue (#b1b9f9 by default) that shows up in permission prompts, the
#>> autocomplete menu and the #-memory hints; the spinner blue (#93a5ff) and the
#>> brand orange (#d77757) join them so the whole conversation reads as one hue.
    "permission": "@PRIMARY@",
    "permissionShimmer": "@CLAUDE_PRIMARY_SHIMMER@",
    "suggestion": "@PRIMARY@",
    "remember": "@PRIMARY@",
    "promptBorder": "@PRIMARY@",
    "promptBorderShimmer": "@CLAUDE_PRIMARY_SHIMMER@",
    "claude": "@PRIMARY@",
    "claudeShimmer": "@CLAUDE_PRIMARY_SHIMMER@",
    "claudeBlue_FOR_SYSTEM_SPINNER": "@PRIMARY@",
    "claudeBlueShimmer_FOR_SYSTEM_SPINNER": "@CLAUDE_PRIMARY_SHIMMER@",
    "clawd_body": "@PRIMARY@",
#>> SECONDARY -- everything that says a MODE is engaged, which is exactly the set
#>> you want to catch your eye against the primary you are reading all day.
#>> Upstream spends three separate hues on these (purple #af87ff, teal #48968c,
#>> pink #fd5db1, blue #4782c8); they are one colour here because what matters is
#>> "a mode is on", and which mode is already written next to the indicator.
    "autoAccept": "@SECONDARY@",
    "autoAcceptShimmer": "@CLAUDE_SECONDARY_SHIMMER@",
    "skill": "@SECONDARY@",
    "merged": "@SECONDARY@",
    "planMode": "@SECONDARY@",
    "bashBorder": "@SECONDARY@",
    "ide": "@SECONDARY@"
#>> DELIBERATELY NOT ACCENTED, and the reason is the one slurm-status.sh.in gives
#>> for drawing job state in fixed neon green and yellow: a colour that answers a
#>> question has to answer it the same way on every machine, whatever accents are
#>> set. So error, warning, success, the six diff colours, every
#>> *_FOR_SUBAGENTS_ONLY (they only work by being distinct from each other), and
#>> text / inverseText / inactive / subtle / background all keep upstream values.
  }
}
