#>> TEMPLATE -- rendered by install.sh with @PRIMARY@ / @PRIMARY_DIM@ substituted.
#>> Edit THIS file, not the rendered config. #>> lines are stripped.

#>> [keys] comes BEFORE the [[keys.command]] blocks on purpose: those implicitly
#>> create the `keys` table, and declaring the super-table after its own
#>> array-of-tables is the one TOML ordering that is not clearly legal.
#>>
#>> herdr's own default binds prefix+j to focus_pane_down, and prefix+j is what
#>> the tmux side uses for the Slurm popup (tmux/.tmux.conf.in) -- the same
#>> muscle memory has to work in both. Moving the default out of the way is
#>> deliberate rather than trusting whichever of the two bindings wins: nothing
#>> documents that precedence, and a popup that silently does not open is worse
#>> than a nav key that moved. Pane-down focus is unaffected in navigate mode,
#>> which has its own prefix-less `j`.
[keys]
focus_pane_down = "prefix+shift+j"

[[keys.command]]
key = "prefix+f"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer"
description = "open file viewer in split"

[[keys.command]]
key = "prefix+shift+f"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer-tab"
description = "open file viewer in tab"

#>> The herdr half of tmux's `bind j display-popup -w 95% -h 85%` -- same key,
#>> same size, so the Slurm popup is one gesture in both. type = "popup" is a
#>> session-modal terminal that leaves the tab layout alone (vs "pane", which
#>> splits, and "shell", which detaches with no terminal at all).
#>>
#>> The command is bin/jwatch, not the watch pipeline spelled out here, for two
#>> reasons. It is the same script tmux's popup can run, so the two cannot drift
#>> apart. And herdr spawns this through portable_pty, documenting only that
#>> *Windows* runs the string through cmd.exe /d /c -- nothing promises a POSIX
#>> host gets a shell, so a compound `a; b` string is not safe to hand it, while
#>> a single executable always is. jwatch itself handles the machines where
#>> jqueue/jruns do not exist (i.e. anything that is not the cluster).
[[keys.command]]
key = "prefix+j"
type = "popup"
command = "jwatch"
width = "95%"
height = "85%"
description = "slurm queue + running jobs"

[ui.toast]
delivery = "herdr"

[ui]
show_agent_labels_on_pane_borders = true
accent = "@PRIMARY@"

# The sidebar keeps herdr's default rows. The only thing themed is `surface_dim`,
# which is the one token herdr routes BOTH the sidebar rail/borders AND the
# selected workspace's background overlay through -- there is no separate border
# color in the [theme.custom] set.
#
# It is a DARKENED primary, not the raw one: the selected row's name is drawn on
# top of this color, and raw @PRIMARY@ would leave that text at ~1.4:1.
# install.sh scales the primary 50% toward black (same hue), which measures
# ~4.5:1 for the name on the selected row and ~2.8:1 for the rail against the
# gruvbox panel.
[theme]
name = "gruvbox"
auto_switch = false

[theme.custom]
surface_dim = "@PRIMARY_DIM@"
