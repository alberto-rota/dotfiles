#!/bin/bash
#>> Rendered to .generated/shell/hsl-login.sh and linked at
#>> ~/.config/dotfiles/hsl-login.sh, which shell/shellrc_additions.sh sources as
#>> its very last act -- from ~/.bashrc and ~/.zshrc alike. @HSL_LOGIN@ is the
#>> wizard's answer, baked in at render time, so turning this off leaves a file
#>> that returns on its second line rather than one that has to re-decide on
#>> every shell.
#>>
#>> SOURCED, never executed: every exit path below must be `return`. An `exit`
#>> here would close the login shell it is running in.
# Launch hsl (herdr plus the status line) at login, if that was asked for --
# or plain herdr where hsl does not exist, which is every Mac. See the bottom of
# this file for that.
#
# This is the only thing in these dotfiles that can lock you out of your own
# machine, so it is deliberately paranoid. Every condition has to hold; it runs
# hsl rather than exec'ing it, so quitting herdr drops you into a normal shell
# instead of ending the session; and NO_HSL=1 in the environment switches it off
# without editing anything, which is the escape hatch to remember if it ever
# does misbehave:
#
#     NO_HSL=1 bash -l          # a plain login shell, no herdr
#     NO_HSL=1 zsh -l           # ...on a machine that logs into zsh
#
HSL_LOGIN=@HSL_LOGIN@
[ "$HSL_LOGIN" = 1 ] || return 0

# The escape hatch, first so it beats everything else.
[ -n "${NO_HSL:-}" ] && return 0

# Once per login. The shell rc gets re-sourced constantly (the `rebash` alias in
# shellrc_additions.sh does exactly that), and each of those would otherwise
# start another herdr on top of the last. Exported so subshells inherit the
# "already handled" answer rather than each deciding again.
[ -n "${DOTFILES_HSL_STARTED:-}" ] && return 0

# Interactive shells only. This rules out `ssh host cmd`, scp/rsync (which break
# outright if a login shell writes to stdout), cron and every script that happens
# to source a shell rc.
case $- in *i*) ;; *) return 0 ;; esac
[ -n "${SSH_ORIGINAL_COMMAND:-}" ] && return 0

# Already inside herdr. It sets all of these in every pane it spawns, and each
# of those panes runs the shell rc -- so without this guard the first thing a new
# herdr pane would do is start a second herdr inside itself.
[ -n "${HERDR_ENV:-}${HERDR_PANE_ID:-}${HERDR_SOCKET_PATH:-}${HERDR_WORKSPACE_ID:-}" ] && return 0

# Inside tmux, or inside an AI coding agent's shell -- both run a shell
# interactively, and a full-screen TUI is wrong in either.
[ -n "${TMUX:-}" ] && return 0
[ -n "${CLAUDECODE:-}${AI_AGENT:-}" ] && return 0

# A real terminal on both ends, and one that can actually draw.
[ -t 0 ] && [ -t 1 ] || return 0
case "${TERM:-dumb}" in dumb|unknown|"") return 0 ;; esac

# And there has to be something to run. hsl is herdr plus the status line, and
# it is now this repo's own (bin/hsl, plain-copied to ~/.local/bin like anything
# else in bin/), so it is on every machine that got the config -- macOS
# included. It used to be the launcher shipped by the herdr-statusline plugin,
# whose manifest is platforms = ["linux"], which meant this whole answer did
# nothing whatsoever on a Mac, silently. That is what bin/hsl fixed.
#
# The fallback to plain herdr stays anyway, for the window where ~/.local/bin is
# not on PATH yet (a first install, before the shell has been re-sourced). The
# answer is "start my workspace manager when I open a terminal"; the status line
# is a detail of how that workspace looks, not the thing being asked for. herdr
# with no arguments launches or attaches to the same persistent session hsl
# wraps -- and bin/hsl itself degrades the same way if tmux is missing.
#
# Both names are unset again afterwards: this file is SOURCED into the user's
# interactive shell, so anything left behind is a variable in their environment
# for the rest of the session.
_hsl_cmd=""
for _hsl_try in hsl herdr; do
  if command -v "$_hsl_try" >/dev/null 2>&1; then _hsl_cmd="$_hsl_try"; break; fi
done
unset _hsl_try
if [ -z "$_hsl_cmd" ]; then
  unset _hsl_cmd
  return 0
fi

export DOTFILES_HSL_STARTED=1
"$_hsl_cmd"
unset _hsl_cmd
